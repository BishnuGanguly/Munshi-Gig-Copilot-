# --- Speech-to-text ---
STT_PROVIDER=mock            # mock | sarvam | faster_whisper
STT_FALLBACK=none            # none | faster_whisper | sarvam
STT_MIN_CONFIDENCE=0.3
SARVAM_API_KEY=
SARVAM_MODEL=saarika:v2.5    # check Sarvam docs; saaras:v3 is their newer recommendation
SARVAM_LANGUAGE_CODE=unknown # UNVERIFIED value for auto-detect; fall back to e.g. hi-IN if the API rejects it
SARVAM_MODE=                 # only for saaras models, optional
WHISPER_MODEL=small

# --- Audio ---
FFMPEG_BIN=              # optional; leave empty to use the bundled ffmpeg
MAX_AUDIO_SECONDS=60
SILENCE_RMS_THRESHOLD=100

# --- Step 1 settings ---
# --- Translation (Step 3) ---
TRANSLATE_PROVIDER=mock      # mock | sarvam | llm   (set to sarvam to translate for real)
TRANSLATE_FALLBACK=none      # none | llm | sarvam
SARVAM_TRANSLATE_MODEL=sarvam-translate:v1   # or mayura:v1
SARVAM_NUMERALS_FORMAT=international         # UNVERIFIED value; retried without it if Sarvam rejects it
ANTHROPIC_API_KEY=           # only for TRANSLATE_*=llm (paid; install with `uv sync --extra llm`)
LLM_TRANSLATE_MODEL=claude-haiku-5-5
DB_PATH=data/munshi.db
LOG_LEVEL=INFO
