# --- Understanding and wording (the model) ---
# Without BRAIN=anthropic the assistant cannot understand anything: it says so instead of guessing.
BRAIN=none                   # none | anthropic   (paid: roughly a paisa per message; `uv sync --extra llm`)
# Either set a key here, or leave it unset and run `ant auth login` once - the SDK finds that profile by
# itself. Do not export an EMPTY value into your shell: the `ant` CLI treats it as a real (broken)
# credential and never falls through to the profile.
# ANTHROPIC_API_KEY=sk-ant-...
BRAIN_MODEL=claude-haiku-5-5         # picks the action
BRAIN_RENDER_MODEL=claude-haiku-5-5  # rewords our English reply in the rider's language
BRAIN_MAX_ACTIONS=3

# --- Speech-to-text ---
STT_PROVIDER=mock            # mock | sarvam | faster_whisper
STT_FALLBACK=none            # none | faster_whisper | sarvam
STT_MIN_CONFIDENCE=0.3
SARVAM_API_KEY=
SARVAM_MODEL=saarika:v2.5    # check Sarvam docs; saaras:v3 is their newer recommendation
SARVAM_LANGUAGE_CODE=unknown # UNVERIFIED value for auto-detect; fall back to e.g. hi-IN if the API rejects it
SARVAM_MODE=                 # only for saaras models, optional
WHISPER_MODEL=small

# --- Voice replies ---
TTS_PROVIDER=mock            # mock (a beep; zero cost) | sarvam
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_SPEAKER=anushka   # v2: anushka manisha vidya arya abhilash karun hitesh
VOICE_MAX_CHARS=400          # longer replies stay text-only

# --- Audio ---
MAX_AUDIO_SECONDS=60
SILENCE_RMS_THRESHOLD=30
FFMPEG_BIN=                  # optional; leave empty to use the bundled ffmpeg

# --- App ---
DB_PATH=data/munshi.db
LOG_LEVEL=INFO
