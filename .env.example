# --- The model (understanding + wording) ---
# BRAIN names the provider. Without it the assistant says the model key is not set.
#     BRAIN=none                 off (the default)
#     BRAIN=sarvam               Sarvam: India-hosted, billed in rupees, reuses SARVAM_API_KEY below
#     BRAIN=openai_compat        any other server speaking the OpenAI-style protocol (see the end of this block)
# A comma-separated list is a chain: the next provider answers only when the one before it is down.
# Run `uv run python scripts/check_llm.py` after setting this.
BRAIN=none
BRAIN_MAX_ACTIONS=3
# BRAIN_MODEL=                  the model of the FIRST provider named above
# BRAIN_MODEL_SARVAM=sarvam-105b        per-provider models (these win over BRAIN_MODEL)
# BRAIN_BASE_URL_SARVAM=https://api.sarvam.ai/v1   override a provider's URL
# BRAIN_REASONING_SARVAM=low     low|medium|high|off|omit. sarvam-105b thinks by default and the thinking uses
#                                up max_tokens; the default is low to choose an action and off to reword
#
# Any other OpenAI-style provider:
# BRAIN=openai_compat
# BRAIN_BASE_URL=https://llm.example.com/v1
# BRAIN_API_KEY_ENV=MY_PROVIDER_KEY     the NAME of the variable holding the key
# BRAIN_AUTH=bearer                     bearer | header:<Name> | none
# BRAIN_MODEL_OPENAI_COMPAT=their-model

# --- Speech-to-text ---
STT_PROVIDER=mock            # mock | sarvam | faster_whisper
STT_FALLBACK=none            # none | faster_whisper | sarvam
STT_MIN_CONFIDENCE=0.3
SARVAM_API_KEY=
SARVAM_MODEL=saarika:v2.5    # check Sarvam docs; saaras:v3 is their newer recommendation
SARVAM_LANGUAGE_CODE=unknown # UNVERIFIED value for auto-detect; fall back to e.g. hi-IN if the API rejects it
SARVAM_MODE=                 # only for saaras models, optional
WHISPER_MODEL=small

# --- Voice replies ---
TTS_PROVIDER=mock            # mock (a beep; zero cost) | sarvam
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_SPEAKER=anushka   # v2: anushka manisha vidya arya abhilash karun hitesh
VOICE_MAX_CHARS=400          # longer replies stay text-only

# --- Audio ---
MAX_AUDIO_SECONDS=60
SILENCE_RMS_THRESHOLD=30
FFMPEG_BIN=                  # optional; leave empty to use the bundled ffmpeg

# --- App ---
DB_PATH=data/munshi.db
LOG_LEVEL=INFO
